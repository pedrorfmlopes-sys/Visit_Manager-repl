{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file=.env --import tsx -e \"process.env.NODE_ENV='development'; import('./server/index.ts');\"",
    "dev:local": "node --env-file=.env --import tsx -e \"process.env.NODE_ENV='development'; import('./server/index.ts');\"",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-visit-manager.ps1",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-tunnel.ps1",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node --env-file=.env -e \"process.env.NODE_ENV='production'; import('./dist/index.js');\"",
    "check": "tsc",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:migrations": "node --env-file-if-exists=.env --import tsx --test tests/integration/migrations.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push",
    "smoke:local": "set START_SERVER=1&& node --env-file=.env ./scripts/smoke-local.cjs",
    "test:e2e": "node --env-file=.env ./node_modules/@playwright/test/cli.js test"
  },
